# ==============================================================================
# EJEMPLO DE terraform.tfvars PARA AWS (valores de muestra, sin credenciales)
# Copiar a terraform.tfvars y completar con tus datos reales.
# ==============================================================================

region        = "us-east-1"
ami_id        = "ami-0abcdef1234567890"
instance_type = "t3.medium"
key_name      = "mi-clave-devops"

# NOTA IMPORTANTE SOBRE CREDENCIALES:
# En AWS las credenciales NO van en terraform.tfvars. Terraform las toma de:
#   - variables de entorno (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
#   - el archivo ~/.aws/credentials (AWS CLI)
#   - el rol IAM de la instancia/worker donde corre Terraform